;
; Raspberry Pi pico-examples pio/uart_tx (BSD-3-Clause)
; 8-N-1 output, 8 PIO cycles per bit. Used on GP16 while SBUS occupies UART0 GP1.
.pio_version 0
.program uart_tx
.side_set 1 opt
    pull      side 1 [7]
    set x, 7  side 0 [7]
bitloop:
    out pins, 1
    jmp x-- bitloop [6]

% c-sdk {
#include "hardware/clocks.h"

static inline void uart_tx_program_init(PIO pio, uint sm, uint offset,
                                         uint pin_tx, uint baud) {
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << pin_tx, 1ull << pin_tx);
    pio_sm_set_pindirs_with_mask64(pio, sm, 1ull << pin_tx, 1ull << pin_tx);
    pio_gpio_init(pio, pin_tx);
    pio_sm_config c = uart_tx_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_out_pins(&c, pin_tx, 1);
    sm_config_set_sideset_pins(&c, pin_tx);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (8 * baud));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
static inline void uart_tx_program_putc(PIO pio, uint sm, uint8_t b) {
    pio_sm_put_blocking(pio, sm, (uint32_t)b);
}
%}
